{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:notdone:schema:workspace-baseline:v1",
  "title": "NotDone Verified Workspace Baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "createdAt", "baseRevision", "workspaceDigest", "files"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "$ref": "#/$defs/id" },
    "createdAt": { "type": "string", "format": "date-time" },
    "baseRevision": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "workspaceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "files": {
      "type": "array",
      "items": { "$ref": "#/$defs/file" }
    },
    "predecessor": { "$ref": "#/$defs/predecessor" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "digest", "size"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "kind": { "enum": ["file", "symlink"] },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size": { "type": "integer", "minimum": 0 }
      }
    },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "verificationReportIds", "taskSnapshotDigest"],
      "properties": {
        "runId": { "$ref": "#/$defs/id" },
        "verificationReportIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "taskSnapshotDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
